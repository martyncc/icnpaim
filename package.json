{
  "name": "icn-paim-ltijs",
  "version": "2.0.0",
  "description": "Aplicación React LTI.js para integración con WordPress",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm start",
    "build": "npm install && cd client && npm install && npm run build",
    "start": "node server/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "ltijs": "^5.9.7",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "express-session": "^1.17.3",
    "body-parser": "^1.20.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2"
  },
  "keywords": ["lti", "react", "wordpress", "education"],
  "author": "ICN PAIM",
  "license": "MIT"
}